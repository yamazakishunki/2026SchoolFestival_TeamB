  m_Text: "\u304A\u90AA\u9B54\n\n\u30AB\u30E9\u30B9 \u7A32\u3092\u8352\u3089\u3057\u306B\u6765\u308B\u304B\u3089\u8FFD\u3044\u6255\u304A\u3046\uFF01\n\n\u30A4\u30CE\u30B7\u30B7
    \u753B\u9762\u306E\u5916\u304B\u3089\u300C\u7530\u3093\u307C\u300D\u3092\u4E00\u76F4\u7DDA\u306B\u8D70\u3063\u3066\u6765\u308B\u3088\u3002\n\u8352\u3089\u3055\u308C\u3061\u3083\u3046\u304B\u3089\u4F53\u5F53\u305F\u308A\u3067\u6B62\u3081\u3088\u3046\uFF01\n[\u6CE8\u610F]
    \u30A4\u30CE\u30B7\u30B7\u306B\u5F53\u305F\u308B\u30682\u79D2\u9593\u6C17\u7D76\u3057\u3061\u3083\u3046\u3088\uFF01\n\n\u30C8\u30E9\u30C3\u30AF
    \u753B\u9762\u306E\u5916\u304B\u3089\u300C\u9053\u300D\u3092\u4E00\u76F4\u7DDA\u306B\u8D70\u3063\u3066\u6765\u308B\u3088\u3002\n\u30A2\u30A4\u30C6\u30E0\u3092\uFF11\u3064\u843D\u3068\u3057\u3066\u304F\u308C\u308B\u3088\uFF01(\uFF12\u3064\u843D\u3068\u3059\u304B\u3082\uFF1F)\n[\u6CE8\u610F]
    \u30C8\u30E9\u30C3\u30AF\u306B\u5F53\u305F\u308B\u30684\u79D2\u9593\u6C17\u7D76\u3057\u3066\u3001\n\u30DE\u30A4\u30CA\u30B9150pt\uFF01\u3000\u3000\u3000\n"
